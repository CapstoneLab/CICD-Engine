# Copy the required values into the existing .env file.
ENGINE_SHARED_TOKEN=replace-with-the-same-token-used-by-the-backend
ENGINE_ID=ubuntu-engine-01
ENGINE_DOCKER_ONLY=true
POLL_INTERVAL_SEC=5
POLL_FETCH_LIMIT=5
ANTHROPIC_API_KEY=

# docker/compose-up.sh sets this automatically. Set it manually only when
# invoking docker compose without the helper.
ENGINE_DATA_ROOT=/absolute/path/to/CICD-Engine/.docker-data

BACKEND_IMAGE=yakdoll/capstone-back:125291b89076d4db1f4970a9c84aa21da60cbdac
# Keep 0.0.0.0 when external clients call port 8000 directly. Use 127.0.0.1
# when a reverse proxy on this host is the only intended entry point.
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8000
CAPSTONE_NETWORK_NAME=capstone-internal

# Each repository is deployed as an independent Docker service on this host.
# This is a user-facing deployment URL. It is not the CICD-Engine/backend API.
# Use the Ubuntu router's directly reachable public IP for DEPLOY_PUBLIC_HOST.
DEPLOY_TARGET=local-docker
DEPLOY_PUBLIC_HOST=112.186.136.153
# Service ports remain host-loopback-only; public traffic enters through Caddy.
DEPLOY_BIND_ADDRESS=127.0.0.1
DEPLOY_PORT_START=10000
DEPLOY_PORT_END=19999
DEPLOY_DOCKER_NETWORK=capstone-internal
DEPLOY_STARTUP_TIMEOUT_SEC=90
DEPLOY_PUBLIC_BASE_URL=https://112.186.136.153/services
DEPLOY_ROUTER_BIND_ADDRESS=127.0.0.1
DEPLOY_ROUTER_PORT=19080

# Caddy is the only public deployment ingress and publishes TCP 80/443.
PUBLIC_INGRESS_BIND_ADDRESS=0.0.0.0
PUBLIC_INGRESS_IMAGE=caddy:2.11.4-alpine

# Pin an administrator-built runtime image ID (docker image inspect --format {{.Id}} IMAGE).
CICD_SANDBOX_IMAGE=
SECURITY_POLICY_MIN_ENVIRONMENT=production
